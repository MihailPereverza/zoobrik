{% import "core/_macros" as m %}
<div class="zb">
  <div class="zb-card-q"><p class="zb-cloze">{{ params.text | gap('blank') | safe }}</p>{% if params.translation %}<span class="zb-translation">{{ params.translation }}</span>{% endif %}{% if params.hint %}<span class="zb-hint" style="font-size:14px">{{ params.hint }}</span>{% endif %}</div>
  <input class="zb-input" data-zb-input autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="пропущенное слово" aria-label="Пропущенное слово">
  <div class="zb-back" data-zb-back hidden>{{ m.explanation(params) }}</div>
</div>
