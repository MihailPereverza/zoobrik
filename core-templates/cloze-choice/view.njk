{% import "core/_macros" as m %}
<div class="zb">
  <div class="zb-card-q">{% if params.instruction %}<div class="zb-instruction zb-md">{{ params.instruction | md | safe }}</div>{% endif %}<p class="zb-cloze">{{ params.text | gap('blank') | safe }}</p>{% if params.translation %}<span class="zb-translation">{{ params.translation }}</span>{% endif %}</div>
  {{ m.options(params.options, seed) }}
  <div class="zb-back" data-zb-back hidden>{{ m.explanation(params) }}</div>
</div>
