{% import "core/_macros" as m %}
<div class="zb">
  <div class="zb-card-q"><p class="zb-prompt">{{ params.prompt }}</p>{% if params.audio %}<div class="zb-row">{{ m.play(media(params.audio)) }}{{ m.playSlow(media(params.audio)) }}</div>{% endif %}</div>
  {{ m.chips(params.answer, params.extra or [], seed) }}
  <div class="zb-back" data-zb-back hidden>{{ m.explanation(params) }}</div>
</div>
