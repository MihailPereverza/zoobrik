{% import "core/_macros" as m %}
<div class="zb">
  <div class="zb-card-q"><span class="zb-translation">Послушай и напиши</span><div class="zb-row">{{ m.play(media(params.audio), true) }}{{ m.playSlow(media(params.audio)) }}</div></div>
  <input class="zb-input" data-zb-input autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="что услышал" aria-label="Что услышал">
  <div class="zb-back" data-zb-back hidden>{{ m.explanation(params) }}</div>
</div>
