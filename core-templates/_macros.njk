{% macro speaker() %}<svg viewBox="0 0 24 24"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>{% endmacro %}
{% macro play(src, big=false, label='Прослушать') %}<button class="zb-play{% if big %} big{% endif %}" data-zb="play" data-src="{{ src }}" aria-label="{{ label }}" type="button">{{ speaker() }}</button>{% endmacro %}
{% macro playSlow(src) %}<button class="zb-play slow" data-zb="play" data-src="{{ src }}" data-rate="0.7" aria-label="Медленно" type="button">0.7×</button>{% endmacro %}
{% macro playSmall(src) %}<button class="zb-play small" data-zb="play" data-src="{{ src }}" aria-label="Прослушать пример" type="button"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>{% endmacro %}
{% macro wordCard(word, ipa, src, slow=true) %}<div class="zb-card-q">
  <span class="zb-prompt word">{{ word }}</span>
  {% if ipa %}<span class="zb-ipa">/{{ ipa }}/</span>{% endif %}
  {% if src %}<div class="zb-row" style="margin-top:6px">{{ play(src) }}{% if slow %}{{ playSlow(src) }}{% endif %}</div>{% endif %}
</div>{% endmacro %}
{% macro options(list, seed) %}<div class="zb-options">{% for o in list | shuffle(seed) %}<button class="zb-option" type="button" data-zb-choice="{{ o }}"><span class="k">{{ loop.index }}</span><span>{{ o }}</span></button>{% endfor %}</div>{% endmacro %}
{% macro chips(answer, extra, seed, items=null) %}<div class="zb-slot{% if items %} phrases{% endif %}" data-zb-slot></div>
<div class="zb-bank{% if items %} phrases{% endif %}">{% for w in (items or (answer | tokens)) | concat(extra) | shuffle(seed) %}<button class="zb-chip" type="button" data-zb-chip="{{ w }}">{{ w }}</button>{% endfor %}</div>
<button class="zb-submit" type="button" data-zb="submit" disabled>Проверить</button>{% endmacro %}
{% macro explanation(params) %}{% if params.explanation %}<div class="zb-note zb-md">{{ params.explanation | md | safe }}</div>{% endif %}{% endmacro %}
{% macro cardInfo(card, theory, media, big=false) %}
<div class="zb-card{% if big %} big{% endif %}">
  {% if card.content.image %}<div class="ci-media"><img src="{{ media(card.content.image) }}" alt=""></div>{% endif %}
  {% if card.kind == 'grammar' %}
    <div class="ci-head"><div><div class="ci-word">{{ card.content.title }}</div>{% if card.content.formula %}<div class="ci-formula">{{ card.content.formula }}</div>{% endif %}</div></div>
  {% else %}
    <div class="ci-head">
      <div>
        <div class="ci-word">{{ card.content.term }}</div>
        <div class="ci-meta">{% if card.content.ipa %}/{{ card.content.ipa }}/{% endif %}{% if card.content.pos %} · {{ card.content.pos }}{% endif %}</div>
      </div>
      {{ play(media(card.content.audio or 'word.mp3')) }}
    </div>
    {% set alts = card.content.alt | notIn(card.content.meaning) %}
    <div class="ci-ru">{{ card.content.meaning }}{% if alts.length %}<span class="ci-alt">также: {{ alts | join(', ') }}</span>{% endif %}</div>
  {% endif %}
  {% if card.content.note %}<div class="ci-tip"><span class="ci-avatar">{{ zubrik('think', 34, 'head') | safe }}</span><div class="ci-note zb-md">{{ card.content.note | md | safe }}</div></div>{% endif %}
  {% if card.content.examples and card.content.examples.length %}
  <div class="ci-sep"></div>
  <ul class="ci-examples">
    {% for ex in card.content.examples %}
    <li>{{ playSmall(media(ex.audio)) }}<div><div class="ci-en">{{ ex.term }}</div><div class="ci-tr">{{ ex.meaning }}</div></div></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if theory %}{% if big %}<div class="ci-sep"></div><div class="ci-theory zb-md">{{ theory | md | safe }}</div>{% else %}<details class="ci-more"><summary>Правило целиком</summary><div class="zb-md">{{ theory | md | safe }}</div></details>{% endif %}{% endif %}
</div>
{% endmacro %}
