{% import "core/_macros" as m %}
<div class="zb">
  {{ m.wordCard(params.front, card.content.ipa, media(params.audio or 'word.mp3')) }}
  <button class="zb-flip" type="button" data-zb="flip">Показать ответ</button>
  <div class="zb-back" data-zb-back hidden>
    <div class="zb-answer">{{ params.back }}</div>
    {% if params.note %}<div class="zb-note zb-md">{{ params.note | md | safe }}</div>{% endif %}
  </div>
</div>
