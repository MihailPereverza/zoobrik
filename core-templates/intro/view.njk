{% import "core/_macros" as m %}
<div class="zb">
  {% if card.kind == 'listening' %}
  <div class="zb-card-q" style="align-items:stretch;text-align:left;padding:18px 20px 20px">
    <div class="zb-card big">
      <div class="ci-head"><div><div class="ci-word" style="font-size:24px">{{ card.content.title }}</div>{% if card.content.source %}<div class="ci-meta">{{ card.content.source }}</div>{% endif %}</div></div>
      {% if card.content.summary %}<div class="ci-tip"><span class="ci-avatar">{{ zubrik('think', 34, 'head') | safe }}</span><div class="ci-note zb-md">{{ card.content.summary | md | safe }}</div></div>{% endif %}
    </div>
    {{ player('') }}
    {% if card.content.attribution %}<p class="zb-source">{{ card.content.attribution }}</p>{% endif %}
  </div>
  <button class="zb-flip" type="button" data-zb="next">Посмотрел(а)</button>
  {% else %}
  <div class="zb-card-q" style="align-items:stretch;text-align:left;padding:18px 20px 20px">{{ m.cardInfo(card, theory, media, true) }}</div>
  <button class="zb-flip" type="button" data-zb="next">Понятно</button>
  {% endif %}
</div>
