{% import "core/_macros" as m %}
<div class="zb">
  <div class="zb-card-q"><p class="zb-prompt wrong">{{ params.wrong }}</p>{% if params.translation %}<span class="zb-translation">{{ params.translation }}</span>{% endif %}</div>
  <input class="zb-input" data-zb-input autocomplete="off" autocapitalize="off" spellcheck="false" value="{{ params.wrong }}" aria-label="Исправленное предложение" style="font-size:17px">
  <div class="zb-back" data-zb-back hidden>{{ m.explanation(params) }}</div>
</div>
