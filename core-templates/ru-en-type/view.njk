{% import "core/_macros" as m %}
<div class="zb">
  <div class="zb-card-q"><span class="zb-prompt word" style="font-size:40px">{{ params.prompt }}</span>{% if card.content.pos %}<span class="zb-translation">{{ card.content.pos }} · {{ topic.title }}</span>{% endif %}</div>
  <input class="zb-input" data-zb-input autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="по-английски" aria-label="Твой ответ">
  {% if params.hint %}<button class="zb-hint-btn" type="button" data-zb="hint">Подсказка</button><div class="zb-hint" data-zb-hint hidden>{{ params.hint }}</div>{% endif %}
  <div class="zb-back" data-zb-back hidden>{% if params.answer != card.content.en %}<div class="zb-answer">{{ params.answer }}</div>{% endif %}{{ m.explanation(params) }}</div>
</div>
